<div class="modal fade" id="addDashboard" tabindex="-1" aria-labelledby="addDashboard" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        <form action="/dashboard/add" method="POST">
            <div class="modal-header">
                <h5 class="modal-title" id="addDashboardLabel">เพิ่มเครื่องให้อาหารใหม่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- 🌟 ลบช่องกรอก Token ออก เพราะระบบหลังบ้านจะสร้างให้อัตโนมัติแล้ว -->
                <div class="mb-3">
                    <label for="dashboardName" class="form-label fw-bold">ตั้งชื่อเรียกอุปกรณ์</label>
                    <input type="text" name="name" class="form-control" id="dashboardName" placeholder="เช่น เครื่องให้อาหารโมจิ" maxlength="30" required>
                    <div class="form-text text-primary"><i class="fa-solid fa-circle-info"></i> ระบบจะสร้างรหัส Pairing Code สำหรับเชื่อมต่อให้อัตโนมัติหลังจากกดบันทึก</div>
                </div>
            </div>

            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> สร้างเครื่องใหม่</button>
            </div>
        </form>
        </div>
    </div>
</div>